---
import '../theme.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import Icon from './Icon.astro';
import Button from './Button.astro';
import Language from './Language.astro';
import { services, industries } from '../content.mjs';
const { title, description, path, schema=[], noindex=false }=Astro.props;
const origin='https://auradigitalworks.com';
const label= title==='Aura Command' ? 'Aura Command | AuraDigital' : title+' | AuraDigital';
const nav=[['Product','/product'],['Services','/services'],['Industries','/industries'],['Pricing','/pricing'],['Resources','/resources']];
const organization={'@type':'Organization','@id':origin+'/#organization',name:'AuraDigital',url:origin,logo:origin+'/auradigital-mark-20260928.png'};
const graph={'@context':'https://schema.org','@graph':[organization,...schema]};
const canonical=origin+path;
const og=origin+'/command-pages/social/'+(path==='/'?'home':path.slice(1).replaceAll('/','-'))+'.png';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{label}</title>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#101414"/>
  <link rel="icon" href="/auradigital-mark-20260928.png"/>
  <link rel="stylesheet" href="/command-assets/tokens.css"/>
  {!noindex && <link rel="canonical" href={canonical}/>}
  {noindex && <meta name="robots" content="noindex"/>}
  <meta property="og:type" content="website"/><meta property="og:site_name" content="AuraDigital"/>
  <meta property="og:title" content={label}/><meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/><meta property="og:image" content={og}/>
  <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
  <meta name="twitter:card" content="summary_large_image"/>
  {!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\\u003c')}/>}
  <script is:inline src="/command-assets/theme-init.js"></script>
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header">
    <div class="nav-wrap wrap">
      <a href="/" class="wordmark" aria-label="AuraDigital home"><img src="/auradigital-mark-20260928.png" alt="" width="32" height="32"/>Aura<span>Digital</span></a>
      <button class="mobile-menu btn btn-ghost" aria-expanded="false" aria-controls="site-nav" type="button"><Icon name="menu"/><span class="sr-only">Menu</span></button>
      <nav id="site-nav" aria-label="Main navigation">
        {nav.map(([name,href])=><a href={href} aria-current={path===href || path.startsWith(href+'/')?'page':undefined}>{name}</a>)}
        <div class="nav-actions"><Language/><button class="theme-toggle btn btn-ghost" type="button" aria-label="Toggle light theme" aria-pressed="false"><Icon name="sun"/></button><a class="btn btn-ghost" href="/hub/login">Login</a><Button/></div>
      </nav>
    </div>
  </header>
  <main id="content"><slot/></main>
  <section class="wrap final-wrap">
    <div class="final-cta"><div><h2>What’s your next move?</h2><p>Tell Auri about your business and get a roadmap you can put to work.</p></div><Button/></div>
  </section>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div><a href="/" class="wordmark" aria-label="AuraDigital home"><img src="/auradigital-mark-20260928.png" alt="" width="32" height="32"/>Aura<span>Digital</span></a><p>Digital growth for small businesses.<br/>Built with AI and real people.</p><Language/></div>
        <div><h2>Product</h2><a href="/product">Aura Command</a><a href="/auri">Meet Auri</a><a href="/hub">AuraHub</a><a href="/how-it-works">How it works</a><a href="/pricing">Pricing</a></div>
        <div><h2>Services</h2>{services.map(s=><a href={'/services/'+s.slug}>{s.name}</a>)}</div>
        <div><h2>Industries</h2>{industries.map(i=><a href={'/industries/'+i.slug}>{i.name}</a>)}</div>
        <div><h2>Company</h2><a href="/about">About</a><a href="/portfolio">Portfolio</a><a href="/shop">Shop</a><a href="/resources">Resources</a><a href="/contact">Contact</a><a href="https://www.instagram.com/auradigitalworks/">Instagram</a><a href="https://wa.me/905385507674">WhatsApp</a></div>
      </div>
      <div class="footer-base"><span>© {new Date().getUTCFullYear()} AuraDigital</span><nav aria-label="Legal"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/cookies">Cookies</a></nav></div>
    </div>
  </footer>
  <script is:inline type="module" src="/command-assets/site.js"></script>
</body>
</html>
