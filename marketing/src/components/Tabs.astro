---
const { id, labels, label } = Astro.props;
---
<div role="tablist" aria-label={label} class="tabs" data-tabs>
  {labels.map((name,i)=><button type="button" role="tab" id={id+'-tab-'+i} aria-controls={id+'-panel-'+i} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{name}</button>)}
</div>
