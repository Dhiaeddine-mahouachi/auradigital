---
import Button from './Button.astro';
const {label, title, description, split=false, cta='Build my roadmap', href, action=true}=Astro.props;
---
<section class:list={['subhero wrap',split&&'split']}>
  <div class="subhero-copy">
    {label&&<p class="kicker">{label}</p>}
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    {action&&<Button href={href}>{cta}</Button>}
    <slot name="extra"/>
  </div>
  <slot/>
</section>
