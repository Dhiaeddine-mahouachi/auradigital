---
import {services} from '../content.mjs';
import PageHero from './PageHero.astro';
import Button from './Button.astro';
import FAQ from './FAQ.astro';
import ServiceCard from './ServiceCard.astro';
import ServiceVisual from './ServiceVisual.astro';
import Icon from './Icon.astro';
const {service:s}=Astro.props;
const related=services.filter(item=>item.slug!==s.slug).sort((a,b)=>Number(b.goal===s.goal)-Number(a.goal===s.goal)).slice(0,3);
---
<PageHero label={s.name} title={s.headline} description={s.detail} split>
  <ServiceVisual service={s}/>
</PageHero>
<section class="section wrap grid2" data-reveal>
  <div class="section-head"><h2>What’s included</h2><p>Review the exact deliverables with the team before approving the scope.</p></div>
  <ul class="check-list">{s.items.map(item=><li><Icon name="check"/>{item}</li>)}</ul>
</section>
<section class="section wrap grid2" data-reveal>
  <div class="section-head"><h2>From brief to delivery</h2><p>{s.delivery}</p></div>
  <ol class="timeline">
    <li><div><h3>Share what you need</h3><p>Tell us what you have, your goals and any materials you want us to use.</p></div></li>
    <li><div><h3>Approve the scope</h3><p>Review the price, target timeline and work included.</p></div></li>
    <li><div><h3>Review and receive</h3><p>Check the draft, request changes within scope and get your handover.</p></div></li>
  </ol>
</section>
<section class="section wrap grid2" data-reveal>
  <div class="section-head"><h2>See what you’ll receive.</h2><p>{s.delivery}</p>{s.reference && <div><Button href={s.reference} variant="outline">Explore existing options</Button></div>}</div>
  <article class="card"><h3>Pricing and scope</h3><p class="lede" data-price-id={s.price}>Request a quote</p><p class="mt-3">The team confirms the price, timing and any ongoing costs before you decide.</p><Button href={'/contact?service='+s.slug} variant="ghost">Ask for a quote</Button></article>
</section>
<FAQ items={[
  ['What do I need to start?', 'Share your business goals, what you already use and the materials you want us to work with.'],
  ['Can I review the work before it goes live?', 'The team shares a review step where it applies to your agreed scope.'],
  ['How long does it take?', 'You receive a target timeline with your scope before work begins.'],
]}/>
<section class="section wrap"><div class="section-head"><h2>Related services</h2></div><div class="grid3">{related.map(service=><ServiceCard service={service}/>)}</div></section>
