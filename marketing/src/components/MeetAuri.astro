---
import PageHero from './PageHero.astro';
import Auri from './Auri.astro';
import Button from './Button.astro';
import Tabs from './Tabs.astro';
import { industries } from '../content.mjs';
const prompts=[
  ['Launch a business','Start by telling me what you sell and how people can find you today. We can turn that into your first steps.'],
  ['Find customers','Tell me where your current customers come from. We can pick one place to improve first.'],
  ['Automate replies','Tell me which questions you answer every day. We can draft replies and decide when a person should step in.'],
];
---
<PageHero label="Meet Auri" title="A guide for your next move." description="Auri helps you sort your ideas into a roadmap and prepare the work you want to request." split>
  <div class="frame"><Auri class="auri-spotlight" eager/><div class="frame-bar"><strong data-auri-level>Level 1</strong><div class="actions">{[1,3,7].map((level,i)=><button class="pill" type="button" data-level={level} aria-pressed={i===0?'true':'false'}>Level {level}</button>)}</div></div></div>
  <Button slot="extra" href="/hub/auri" variant="outline">Talk to Auri</Button>
</PageHero>
<section class="section wrap" data-reveal>
  <div class="section-head"><h2>Try a conversation.</h2><p>These sample replies show the kind of questions Auri can help you think through.</p></div>
  <div class="filters" aria-label="Example prompts">{prompts.map(([label,answer],i)=><button type="button" data-prompt={answer} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div>
  <blockquote class="quote" data-prompt-answer aria-live="polite">{prompts[0][1]}</blockquote>
  <div class="mt-8"><Tabs id="auri-demo" label="Example by industry" labels={industries.map(i=>i.name)}/>{industries.map((i,index)=><div id={'auri-demo-panel-'+index} role="tabpanel" aria-labelledby={'auri-demo-tab-'+index} tabindex="0" hidden={index!==0} class="card"><p>{i.ask}</p></div>)}</div>
</section>
<section class="section wrap grid2">
  <article class="card"><h3>What Auri can help with</h3><p>Suggest next steps from the details you share, explain service options and help you prepare a project request.</p></article>
  <article class="card"><h3>Where you and the team step in</h3><p>You approve purchases and changes. The team confirms details, verifies work and delivers what you’ve agreed on.</p><Button href="/privacy" variant="ghost">How data is handled</Button></article>
</section>
