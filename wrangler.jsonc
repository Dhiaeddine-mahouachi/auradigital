{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auradigital",
  "main": "src/worker-entry.js",
  "upload_source_maps": false,
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/qusai",
      "/qusai/",
      "/restaurants/dashboard",
      "/_next/*",
      "/assets/*",
      "/weddings/*",
      "/",
      "/*.html",
      "!/admin/*",
      "/home",
      "/services",
      "/websites",
      "/spinflow",
      "/hizmetler",
      "/portfolio",
      "/aura-menu",
      "/aura-weddings",
      "/auraweddings",
      "/aurapops",
      "/nfc",
      "/qr-menu",
      "/packages",
      "/paketler",
      "/about",
      "/hakkimizda",
      "/contact",
      "/iletisim",
      "/nfc-studio",
      "/nfc-durum",
      "/nfc-status",
      "/aurapops/",
      "/shop",
      "/shop/",
      "/shop/cards/*",
      "/shop/cart",
      "/shop/checkout",
      "/shop/orders/*",
      "/account",
      "/account/*"
    ],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auradigital-db",
      "database_id": "6d89053c-4979-4e54-9976-bbfb884cb5ca",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "REQUEST_NOTIFICATIONS"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1843704",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1843701",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "TRACK_RATE_LIMITER",
      "namespace_id": "1843702",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1843703",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "auradigitalworks.com/*",
      "zone_name": "auradigitalworks.com"
    },
    {
      "pattern": "www.auradigitalworks.com/*",
      "zone_name": "auradigitalworks.com"
    },
    {
      "pattern": "auradigital.ink/*",
      "zone_name": "auradigital.ink"
    },
    {
      "pattern": "www.auradigital.ink/*",
      "zone_name": "auradigital.ink"
    },
    {
      "pattern": "app.auradigital.ink",
      "custom_domain": true
    },
    {
      "pattern": "auradigitalworks.com/aurapops",
      "zone_name": "auradigitalworks.com"
    },
    {
      "pattern": "auradigitalworks.com/aurapops/",
      "zone_name": "auradigitalworks.com"
    },
    {
      "pattern": "auradigitalworks.com/aurapops.html",
      "zone_name": "auradigitalworks.com"
    },
    {
      "pattern": "auradigitalworks.com/aurapops-showcase.html",
      "zone_name": "auradigitalworks.com"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_PROVIDER": "cloudflare",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "AI_DAILY_TOKEN_LIMIT": "500000",
    "AI_DAILY_BUDGET_USD": "1",
    "AI_RECOVERY_DAY": "2026-10-13",
    "AI_RECOVERY_TOKEN_ALLOWANCE": "250000"
  },
  "build": {
    "command": "node scripts/build-ai-index.mjs && node scripts/build-shop.mjs"
  },
  "triggers": {
    "crons": [
      "0 3 * * *",
      "*/5 * * * *"
    ]
  }
}
