{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auradigital",
  "main": "src/worker-entry.js",
  "upload_source_maps": false,
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/qusai",
      "/qusai/",
      "/quicksite",
      "/quicksite/*",
      "/restaurants/dashboard",
      "/_next/*",
      "/assets/*",
      "/",
      "/*.html",
      "!/admin/*",
      "/home",
      "/services",
      "/hizmetler",
      "/portfolio",
      "/aura-menu",
      "/nfc",
      "/qr-menu",
      "/packages",
      "/paketler",
      "/about",
      "/hakkimizda",
      "/contact",
      "/iletisim",
      "/nfc-studio",
      "/nfc-durum",
      "/nfc-status"
    ],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auradigital-db",
      "database_id": "6d89053c-4979-4e54-9976-bbfb884cb5ca",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "REQUEST_NOTIFICATIONS"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1843701",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "TRACK_RATE_LIMITER",
      "namespace_id": "1843702",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "app.auradigital.ink",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "NOTIFICATION_EMAIL"
    ]
  }
}
